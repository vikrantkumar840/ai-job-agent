# DO NOT COMMIT THE REAL VERSION OF THIS FILE TO GIT.
# Copy this to 02-secrets.yaml, fill in real values, apply it, and make sure
# 02-secrets.yaml is in .gitignore.
#
# Generate strong random values with: openssl rand -hex 32

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: ai-job-agent
type: Opaque
stringData:
  POSTGRES_USER: "postgres"
  POSTGRES_PASSWORD: "REPLACE_ME_STRONG_PASSWORD"

  MONGO_ROOT_USER: "mongoadmin"
  MONGO_ROOT_PASSWORD: "REPLACE_ME_STRONG_PASSWORD"
  # Must match MONGO_ROOT_USER / MONGO_ROOT_PASSWORD above
  MONGODB_URI: "mongodb://mongoadmin:REPLACE_ME_STRONG_PASSWORD@mongodb:27017/?authSource=admin"

  JWT_SECRET_KEY: "REPLACE_ME_openssl_rand_hex_32"

  GROQ_API_KEY: "REPLACE_ME"
  ADZUNA_APP_ID: "REPLACE_ME"
  ADZUNA_APP_KEY: "REPLACE_ME"

  SMTP_HOST: "smtp.gmail.com"
  SMTP_PORT: "587"
  SMTP_EMAIL: "REPLACE_ME@gmail.com"
  SMTP_APP_PASSWORD: "REPLACE_ME"
  NOTIFY_TO_EMAIL: "REPLACE_ME@gmail.com"
